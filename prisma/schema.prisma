generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String
  username      String          @unique
  pin           String
  role          String          @default("member") // "admin" | "member"
  team          String          @default("General")
  active        Boolean         @default(true)
  sessions      WorkSession[]
  payments      PaymentRecord[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model WorkSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  startAt     DateTime
  endAt       DateTime
  hourlyRate  Float
  adenaRate   Float
  adenaUnit   Float
  startAdena  Float
  endAdena    Float
  note        String?
  createdAt   DateTime @default(now())
}

model PaymentRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  paidAt    DateTime
  note      String?
  createdAt DateTime @default(now())
}

model GlobalSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
